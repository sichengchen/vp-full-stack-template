{
  "name": "vp-full-stack-template",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run --filter ./apps/api --filter ./apps/web dev",
    "build": "vp run -r build",
    "check": "vp run -r check",
    "lint": "vp run -r lint",
    "test": "vp run -r test",
    "fmt": "prettier --write .",
    "template:init": "node scripts/init-template.mjs",
    "entity:add": "tsx scripts/add-entity.ts",
    "db:push": "vp run @template/db#db:push",
    "db:studio": "vp run @template/db#db:studio"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "packageManager": "pnpm@10.23.0"
}
